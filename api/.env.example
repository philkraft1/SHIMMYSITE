# Copy to .env and fill in from https://developer.squareup.com/apps
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
PORT=3001

# Optional: where Square sends buyers after payment
CHECKOUT_REDIRECT_URL=

# Newsletter + booking requests are emailed here (FormSubmit.co — free)
# First submission emails an Activate Form link — click it (check spam) or deliveries stay blocked.
NEWSLETTER_INBOX=therosenfeldranch@gmail.com

# Used as Origin/Referer for FormSubmit (must look like a real website URL)
SITE_PUBLIC_URL=https://therosenfeldranch.com

# Optional: protect GET /api/customers (send as x-admin-key header)
ADMIN_KEY=

# Production: free Neon Postgres connection string (https://neon.tech)
# Leave empty locally to use SQLite at api/data/customers.db
DATABASE_URL=
