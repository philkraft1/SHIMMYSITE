# Copy to .env and fill in from https://developer.squareup.com/apps
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
PORT=3001

# Optional: where Square sends buyers after payment (orderId/transactionId appended).
# Prefer the ranch admissions page so guests land back on purchase UI.
CHECKOUT_REDIRECT_URL=https://rosenfeldranch.com/ranch.html

# Newsletter + booking requests are emailed here (FormSubmit.co — free)
# First submission emails an Activate Form link — click it (check spam) or deliveries stay blocked.
NEWSLETTER_INBOX=therosenfeldranch@gmail.com

# Used as Origin/Referer for FormSubmit (must look like a real website URL)
SITE_PUBLIC_URL=https://rosenfeldranch.com

# Required to publish/delete blog posts and list customers/bookings.
# Send as x-admin-key header. Never put this value in frontend JS.
ADMIN_KEY=

# Production: free Neon Postgres connection string (https://neon.tech)
# Leave empty locally to use SQLite at api/data/customers.db
DATABASE_URL=
